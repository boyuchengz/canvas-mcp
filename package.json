{
  "name": "canvas-mcp",
  "version": "1.2.0",
  "description": "Read-only MCP server that connects Claude, ChatGPT and other AI assistants to Canvas LMS.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test",
    "check": "node --check src/server.js && node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^4.22.3",
    "zod": "^4.6.7"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "canvas",
    "canvas-lms",
    "instructure",
    "claude",
    "chatgpt",
    "education"
  ],
