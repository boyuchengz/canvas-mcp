  "repository": {
    "type": "git",
    "url": "git+https://github.com/boyuchengz/canvas-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/boyuchengz/canvas-mcp/issues"
  },
  "homepage": "https://github.com/boyuchengz/canvas-mcp#readme"
